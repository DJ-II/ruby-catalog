<div class="mb-4">
  <div class="eyebrow text-primary mb-2"><%= @inventory.title %></div>
  <h1 class="h2 fw-bold mb-1"><%= t('access.title') %></h1>
  <p class="text-body-secondary"><%= t('access.description') %></p>
</div>
<%= render 'shared/inventory_nav', inventory: @inventory, active: :access %>
<section class="form-panel mb-4">
  <h2 class="h5 fw-semibold mb-3"><%= t('access.add') %></h2>
  <%= form_with url: inventory_accesses_path(@inventory), method: :post, class: 'row g-2' do |f| %>
    <div class="col-sm-9"><%= text_field_tag :identifier, nil, placeholder: t('access.placeholder'), class: 'form-control', required: true, autocomplete: 'off', list: 'access-suggestions', data: { suggest_url: suggest_inventory_accesses_path(@inventory) } %><datalist id="access-suggestions"></datalist></div>
    <div class="col-sm-3"><%= f.submit t('access.add'), class: 'btn btn-primary w-100' %></div>
  <% end %>
</section>
<section class="table-panel">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 fw-semibold mb-0"><%= t('access.allowed') %></h2>
    <div class="small"><%= link_to t('access.sort_name'), inventory_accesses_path(@inventory, sort: 'name') %> · <%= link_to t('access.sort_email'), inventory_accesses_path(@inventory, sort: 'email') %></div>
  </div>
  <%= form_with url: bulk_destroy_inventory_accesses_path(@inventory), method: :delete, data: { bulk_selection: "access_ids[]" } do |f| %>
    <%= f.submit t('access.revoke'), class: 'btn btn-sm btn-outline-danger mb-3', data: { bulk_action: true, turbo_confirm: t('forms.confirm') } %>
    <span class="small text-body-secondary" data-bulk-count aria-live="polite" hidden><%= t('bulk.selected') %> <span data-bulk-number>0</span></span>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th><input type="checkbox" data-bulk-all aria-label="<%= t('items.select_all') %>"></th>
            <th><%= t('auth.username') %></th>
            <th><%= t('auth.email') %></th>
          </tr>
        </thead>
        <tbody>
          <% if @accesses.any? %>
            <% @accesses.each do |access| %>
              <tr>
                <td><%= check_box_tag 'access_ids[]', access.id, false, class: 'form-check-input', aria: { label: t('access.select_user', username: access.user.username) } %></td>
                <td><%= link_to access.user.username, user_path(access.user), class: 'text-decoration-none' %></td>
                <td><%= access.user.email %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="3" class="empty-state"><%= t('access.empty') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <%= render 'shared/pagination', slice: @accesses_page, page_key: :page %>
</section>
