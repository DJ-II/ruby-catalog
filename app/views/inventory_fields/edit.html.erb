<div class="d-flex align-items-end justify-content-between flex-wrap gap-3 mb-4"><div><div class="eyebrow text-primary mb-2"><%= @inventory.title %></div><h1 class="h2 fw-bold mb-1"><%= t('fields.title') %></h1><p class="text-body-secondary mb-0"><%= t('fields.description') %></p></div></div>
<%= render 'shared/inventory_nav', inventory: @inventory, active: :fields %>
<%= form_with url: inventory_fields_path(@inventory), method: :patch, data: { inventory_autosave: true } do |f| %>
  <%= hidden_field_tag :lock_version, @inventory.lock_version %>
  <section class="table-panel mb-4"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th class="field-order-heading" title="<%= t('ids.drag') %>"><%= t('fields.order') %></th><th><%= t('fields.enabled') %></th><th><%= t('fields.type') %></th><th><%= t('fields.label') %></th><th><%= t('fields.hint') %></th><th><%= t('fields.table') %></th></tr></thead><tbody data-sort-fields>
    <% @fields.each do |field| %>
      <% key = "fields[#{field.kind}_#{field.slot}]" %>
      <tr data-field-row>
        <td><span class="field-drag-handle" data-field-handle role="button" tabindex="0" aria-label="<%= t('ids.drag') %>">⠿</span><input type="hidden" name="<%= key %>[position]" value="<%= field.position %>" data-field-position></td>
        <td><input type="hidden" name="<%= key %>[active]" value="0"><%= check_box_tag "#{key}[active]", '1', field.active?, class: 'form-check-input', data: { field_active: true }, aria: { label: t('fields.enable_field', type: t("fields.kinds.#{field.kind}"), slot: field.slot) } %></td>
        <td class="text-body-secondary small text-nowrap"><%= t("fields.kinds.#{field.kind}") %> #<%= field.slot %></td>
        <td><%= text_field_tag "#{key}[title]", field.title, class: 'form-control form-control-sm', maxlength: 100, placeholder: t('fields.label') %></td>
        <td><%= text_field_tag "#{key}[description]", field.description, class: 'form-control form-control-sm', maxlength: 1000, placeholder: t('fields.hint') %></td>
        <td><input type="hidden" name="<%= key %>[visible_in_table]" value="0"><%= check_box_tag "#{key}[visible_in_table]", '1', (field.active? && field.visible_in_table?), class: 'form-check-input', disabled: !field.active?, data: { field_visible: true }, aria: { label: t('fields.table_field', type: t("fields.kinds.#{field.kind}"), slot: field.slot) } %></td>
      </tr>
    <% end %>
  </tbody></table></div></section>
  <%= render 'shared/autosave_status', reload_url: edit_inventory_fields_path(@inventory) %>
  <div class="d-flex gap-2"><%= f.submit t('forms.save'), class: 'btn btn-primary' %><%= link_to t('forms.cancel'), inventory_path(@inventory), class: 'btn btn-outline-secondary' %></div>
<% end %>
