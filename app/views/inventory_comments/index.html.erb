<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <div class="eyebrow text-primary mb-2"><%= link_to @inventory.title, inventory_path(@inventory), class: 'text-decoration-none' %></div>
    <h1 class="h2 fw-bold mb-1"><%= t('comments.title') %></h1>
    <p class="text-body-secondary mb-0"><%= t('comments.description') %></p>
  </div>
  <% if @history %><%= link_to t('comments.latest'), inventory_comments_path(@inventory), class: 'btn btn-outline-primary' %><% end %>
</div>
<%= render 'shared/inventory_nav', inventory: @inventory, active: :discussion %>
<section class="table-panel mb-4" <% unless @history %>data-discussion-feed data-poll-url="<%= inventory_comments_path(@inventory, format: :json) %>" data-last-id="<%= @last_id %>"<% end %>>
  <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
    <h2 class="h5 fw-semibold mb-0"><%= t('comments.posts') %></h2>
    <% unless @history %><span class="small text-body-secondary"><%= t('comments.auto_refresh') %></span><% end %>
  </div>
  <% if @older_id %><%= link_to t('comments.older'), inventory_comments_path(@inventory, before_id: @older_id), class: 'btn btn-sm btn-outline-secondary mb-3' %><% end %>
  <div data-discussion-list>
    <%= render partial: 'inventory_comments/comment', collection: @comments, as: :comment %>
  </div>
  <% if @comments.empty? %><p data-discussion-empty class="text-body-secondary mb-0"><%= t('comments.empty') %></p><% end %>
</section>
<% if logged_in? && !@history %>
  <section class="form-panel wide-panel">
    <h2 class="h5 fw-semibold mb-3"><%= t('comments.new') %></h2>
    <%= render 'shared/errors', record: @comment %>
    <%= form_with model: [@inventory, @comment], url: inventory_comments_path(@inventory) do |f| %>
      <%= f.label :body, t('comments.body'), class: 'form-label fw-semibold' %>
      <%= f.text_area :body, rows: 5, maxlength: 4000, required: true, class: 'form-control mb-2', placeholder: t('comments.placeholder') %>
      <p class="small text-body-secondary mb-3"><%= t('comments.markdown') %></p>
      <%= f.submit t('comments.send'), class: 'btn btn-primary' %>
    <% end %>
  </section>
<% elsif !logged_in? %>
  <p class="text-body-secondary small"><%= t('comments.login_hint') %> <%= link_to t('navigation.login'), login_path %></p>
<% end %>
