<div class="form-panel mx-auto narrow-panel">
  <h1 class="h2 fw-bold mb-4"><%= t('auth.login') %></h1>
  <%= form_with url: login_path, data: { turbo: false } do |f| %>
    <div class="mb-3"><%= f.label :email, t('auth.email'), class: 'form-label' %><%= f.email_field :email, class: 'form-control', required: true, autocomplete: 'email' %></div>
    <div class="mb-4"><%= f.label :password, t('auth.password'), class: 'form-label' %><%= f.password_field :password, class: 'form-control', required: true, autocomplete: 'current-password' %></div>
    <%= f.submit t('auth.login'), class: 'btn btn-primary w-100' %>
  <% end %>
  <%= render 'shared/oauth_buttons', intent: 'login' %>
  <p class="mt-3 text-body-secondary"><%= t('auth.no_account') %> <%= link_to t('auth.signup'), signup_path %></p>
</div>
