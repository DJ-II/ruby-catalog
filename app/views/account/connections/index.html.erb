<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
  <div><div class="eyebrow text-primary mb-1"><%= t('oauth.account') %></div><h1 class="h2 fw-bold mb-1"><%= t('oauth.connections') %></h1><p class="text-body-secondary mb-0"><%= t('oauth.connections_help') %></p></div>
  <%= link_to t('navigation.my_profile'), user_path(current_user), class: 'btn btn-outline-secondary' %>
</div>
<div class="form-panel mx-auto" style="max-width:760px">
  <% [['google_oauth2', 'Google'], ['github', 'GitHub'], ['facebook', 'Facebook']].each do |provider, label| %>
    <% connected = @connections.find { |identity| identity.provider == provider } %>
    <% next if provider == 'facebook' && !connected && !oauth_provider_enabled?(provider) %>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 py-3 border-bottom">
      <div><div class="fw-semibold"><%= label %></div><div class="small text-body-secondary"><%= t(connected ? 'oauth.connected' : 'oauth.disconnected') %></div></div>
      <% if connected %>
        <% if current_user.password_login_enabled? || @connections.size > 1 %>
          <%= button_to t('oauth.disconnect'), account_connection_path(provider), method: :delete, class: 'btn btn-outline-danger btn-sm', form: { data: { turbo_confirm: t('oauth.disconnect_confirm') } } %>
        <% else %>
          <span class="small text-body-secondary"><%= t('oauth.last_method') %></span>
        <% end %>
      <% elsif oauth_provider_enabled?(provider) %>
        <%= button_to t('oauth.connect'), "/auth/#{provider}", method: :post, params: { intent: 'link' }, form: { data: { turbo: false } }, class: 'btn btn-outline-primary btn-sm' %>
      <% else %>
        <span class="small text-body-secondary"><%= t('oauth.not_configured') %></span>
      <% end %>
    </div>
  <% end %>
  <p class="small text-body-secondary mt-3 mb-0"><%= t('oauth.security_note') %></p>
</div>
