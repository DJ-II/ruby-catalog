<div class="page-heading d-flex align-items-end justify-content-between flex-wrap gap-3 mb-4">
  <div><h1 class="fw-bold"><%= t('search.title') %></h1>
    <% if @query.present? %><p class="text-body-secondary mb-0"><%= t('search.query') %>: <strong><%= @query %></strong></p><% end %>
    <% if @tag.present? %><p class="text-body-secondary mb-0"><%= t('tags.filtered_by') %>: <strong>#<%= @tag %></strong> · <%= link_to t('tags.clear_filter'), search_path(q: @query.presence) %></p><% end %>
  </div>
  <% if current_user %><%= link_to t('inventories.new'), new_inventory_path, class: 'btn btn-primary' %><% end %>
</div>
<section class="table-panel mb-4"><h2 class="h5 fw-bold mb-3"><%= t('search.inventories') %></h2><%= render 'shared/inventory_table', inventories: @inventories %><%= render 'shared/pagination', slice: @inventories_page, page_key: :inventory_page %></section>
<% if @show_items %>
<section class="table-panel"><h2 class="h5 fw-bold mb-3"><%= t('search.items') %></h2><div class="table-responsive"><table class="table table-hover align-middle mb-0">
  <thead><tr><th><%= t('table.item_id') %></th><th><%= t('table.inventory') %></th><th><%= t('table.creator') %></th></tr></thead><tbody>
  <% if @items.any? %>
    <% @items.each do |item| %><tr><td><%= link_to item.custom_id, inventory_item_path(item.inventory, item), class: 'text-decoration-none fw-semibold' %></td><td><%= link_to item.inventory.title, inventory_path(item.inventory), class: 'text-decoration-none' %></td><td><%= item.creator&.username || '—' %></td></tr><% end %>
  <% else %><tr><td colspan="3" class="empty-state"><%= t('search.empty') %></td></tr><% end %>
  </tbody></table></div><%= render 'shared/pagination', slice: @items_page, page_key: :item_page %></section>
<% end %>
